{
  "app-id": "io.github.AUSSIEbattler96_AI.Periphera",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "base": "com.riverbankcomputing.PyQt.BaseApp",
  "base-version": "6.10",
  "command": "periphera",
  "separate-locales": false,
  "build-options": {
    "env": {"BASEAPP_REMOVE_WEBENGINE": "1"}
  },
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=all",
    "--talk-name=org.razer"
  ],
  "cleanup-commands": ["/app/cleanup-BaseApp.sh"],
  "modules": [
    {
      "name": "python3-jeepney",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --no-deps --prefix=/app jeepney-0.9.0-py3-none-any.whl"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/b2/a3/e137168c9c44d18eff0376253da9f1e9234d0239e0ee230d2fee6cea8e55/jeepney-0.9.0-py3-none-any.whl",
          "sha256": "97e5714520c16fc0a45695e5365a2e11b81ea79bba796e26f9f1d178cb182683"
        }
      ]
    },
    {
      "name": "periphera",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 barracuda.py barracuda_gui.py naga.py naga_gui.py mousemat.py mousemat_gui.py openrazer_backend.py openrazer_gui.py openrazer_catalog.json -t /app/lib/periphera/",
        "install -Dm755 packaging/periphera /app/bin/periphera",
        "install -Dm644 packaging/io.github.AUSSIEbattler96_AI.Periphera.desktop -t /app/share/applications/",
        "install -Dm644 packaging/io.github.AUSSIEbattler96_AI.Periphera.metainfo.xml -t /app/share/metainfo/",
        "install -Dm644 packaging/io.github.AUSSIEbattler96_AI.Periphera.png /app/share/icons/hicolor/512x512/apps/io.github.AUSSIEbattler96_AI.Periphera.png",
        "install -Dm644 packaging/io.github.AUSSIEbattler96_AI.Periphera.png /app/lib/periphera/io.github.AUSSIEbattler96_AI.Periphera.png",
        "install -Dm644 LICENSE README.md docs/HOST_SETUP.md docs/SUPPORT.md docs/MOUSE_MATS.md -t /app/share/doc/periphera/"
      ],
      "run-tests": true,
      "test-commands": [
        "QT_QPA_PLATFORM=offscreen python3 -m unittest discover -v",
        "QT_QPA_PLATFORM=offscreen python3 scripts/smoke_gui.py"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [".git", ".flatpak-builder", "build", "repo", "dist", "__pycache__"]
        }
      ]
    }
  ]
}
